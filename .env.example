# Configuración para ejecutar con Node (desarrollo local o servidor propio como EC2).
# Copia este archivo como .env (no se sube a git).

PORT=8787
# Secreto para firmar enlaces de citas: 32+ caracteres aleatorios. ¡No lo cambies después!
APP_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-o-mas-caracteres
# Clave para crear demos y consultorios en /plataforma (24+ caracteres).
PLATFORM_ADMIN_KEY=cambia-esto-por-otra-clave-larga-de-24-o-mas
# Archivo de la base de datos SQLite.
DATABASE_FILE=./data/agenda-sonrisa.db
# Iteraciones PBKDF2 para contraseñas (máx. 100000).
PASSWORD_HASH_ITERATIONS=100000
SESSION_TTL_HOURS=12
# true solo si el servidor está detrás de un proxy propio (Nginx, balanceador).
TRUST_PROXY=false
# Datos del consultorio demo que se crea la primera vez (opcional).
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=
